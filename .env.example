# ═══════════════════════════════════════════════════════════
# SOCGuard - Configuración de Monitoreo e Incidentes ServiceNow
# ═══════════════════════════════════════════════════════════

# Ruta base donde se encuentran todas las automatizaciones a monitorear
# Si se deja vacío, tomará automáticamente la carpeta contenedora superior
INITIATIVES_ROOT=C:/Users/<usuario>/Tareas automaticas

# ─── ServiceNow ───────────────────────────────────────────
# Si ya están definidas como variables de entorno del sistema Windows,
# no es necesario repetirlas aquí (se leerán automáticamente del sistema).
SN_URL=https://<instancia>.service-now.com/
SN_USER=
SN_PASS=
SNOW_ASSIGNMENT_GROUP=grupo-asignacion-soc
SNOW_ASSIGNED_TO=SOAR
SN_CATEGORY=Software
SN_SUBCATEGORY=Job Failure
SN_IMPACT=3
SN_URGENCY=3
SN_VERIFY_SSL=false
SN_TIMEOUT=30

# ─── Deduplicación y Alertas ──────────────────────────────
# Evitar crear múltiples tickets para una misma iniciativa en el mismo día
DEDUP_WINDOW_HOURS=24

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
